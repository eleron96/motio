# Copy to .env.metabase on prod and fill in real values. Never commit .env.metabase.
# Location on prod: /opt/new_toggl/infra/metabase/.env.metabase

# Password for Metabase's own app metadata DB (metabase-db container).
# Generate: openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
METABASE_APP_DB_PASSWORD=CHANGE_ME

# Read-only credentials for connecting Metabase to the main prod Postgres.
# Role metabase_ro is provisioned in infra-db-1 (BYPASSRLS, SELECT-only,
# statement_timeout=60s). The password below is entered in Metabase UI
# when adding the data source — it is not read by docker-compose, kept
# here only as a note for operators.
#
# METABASE_MAIN_DB_HOST=db            # resolves inside infra_default network
# METABASE_MAIN_DB_PORT=5432
# METABASE_MAIN_DB_NAME=postgres
# METABASE_MAIN_DB_USER=metabase_ro
# METABASE_MAIN_DB_PASS=<set in Metabase UI>
